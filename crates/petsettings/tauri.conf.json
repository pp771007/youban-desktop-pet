{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YoubanSettings",
  "version": "0.1.0",
  "identifier": "tw.pp.youbandesktoppet.settings",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "柚伴設定",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://pet.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
